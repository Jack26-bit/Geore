# Google Gemini API key (required) — get from https://aistudio.google.com
GEMINI_API_KEY=

# NVIDIA NIM API key (optional fallback) — get from https://build.nvidia.com
NVIDIA_API_KEY=

# Override model names if needed
# GEMINI_MODEL=gemini-2.5-flash
# NVIDIA_MODEL=nvidia/nemotron-nano-12b-v2-vl

# Google Earth Engine credentials
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT_KEY_PATH=
